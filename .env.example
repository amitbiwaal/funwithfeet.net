# ---------------------------------------------------------------
# FunWithFeet.net — environment variables
# Copy to .env.local and fill in.
# ---------------------------------------------------------------

# First admin account. Used only when the database is created for the
# first time. Change the password later in Admin → Account, or run:
#   npm run admin:create -- you@example.com "new-password"
ADMIN_EMAIL=admin@funwithfeet.net
ADMIN_PASSWORD=change-me-to-something-long

# Hosted database (Turso), required on Vercel. Leave unset locally to use
# the SQLite file in DATA_DIR. With it set, uploaded images go to Vercel
# Blob, so the Blob credentials Vercel adds are needed as well.
# TURSO_DATABASE_URL=libsql://your-db-your-org.turso.io
# TURSO_AUTH_TOKEN=
# BLOB_READ_WRITE_TOKEN=
# Set to private only if your Blob store is private. Default: public
# BLOB_ACCESS=public

# Where the local SQLite database and uploaded images are stored when
# TURSO_DATABASE_URL is not set. Must be a persistent disk. Default: ./data
# DATA_DIR=./data

# The whole site is noindex (hidden from search engines) unless this is
# false. Set it to false when the site should appear in Google.
# SITE_NOINDEX=false

# Seed two starter blog articles on first run (true/false). Default: true
# SEED_DEMO_CONTENT=true

# Session cookies are "Secure" in production. Set to false ONLY if you
# serve the site over plain http (not recommended).
# COOKIE_SECURE=true
