# ---------------------------------------------------------------
# FunWithFeet.net — environment variables
# Copy to .env.local and fill in.
# ---------------------------------------------------------------

# First admin account. Used only when the database is created for the
# first time. Change the password later in Admin → Account, or run:
#   npm run admin:create -- you@example.com "new-password"
ADMIN_EMAIL=admin@funwithfeet.net
ADMIN_PASSWORD=change-me-to-something-long

# Where the SQLite database and uploaded images are stored.
# Must be a persistent disk in production. Default: ./data
# DATA_DIR=./data

# Seed two starter blog articles on first run (true/false). Default: true
# SEED_DEMO_CONTENT=true

# Session cookies are "Secure" in production. Set to false ONLY if you
# serve the site over plain http (not recommended).
# COOKIE_SECURE=true
